# Скопируйте этот файл в .env.local и задайте свои значения.
# .env.local НЕ коммитится (см. .gitignore).
#
# Быстрый способ сгенерировать крепкие значения:
#   node scripts/gen-env.mjs           (не перезапишет существующий)
#   node scripts/gen-env.mjs --force   (перезаписать)

# Логин и пароль для входа в админку /admin
ADMIN_LOGIN=doccar
ADMIN_PASSWORD=смените-на-крепкий-пароль

# Секрет для подписи cookie-сессии (любая длинная случайная строка).
# Напр.: openssl rand -hex 32
ADMIN_SECRET=смените-на-длинную-случайную-строку

# Если переменные не заданы, используются небезопасные значения по умолчанию
# (login: doccar, password: doccar-admin) — для боевого сайта ОБЯЗАТЕЛЬНО задайте свои.
